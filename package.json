{
  "name": "xaga",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist src-tauri/target",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:debug": "RUST_LOG=xaga=debug tauri dev",
    "clean:build": "npm run clean && npm run tauri build",
    "cli:build": "cargo build -p xaga-cli",
    "cli:build:release": "cargo build -p xaga-cli --release",
    "cli:run": "cargo run -p xaga-cli --"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
