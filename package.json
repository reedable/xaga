{
  "name": "xaga",
  "version": "0.9.0-rc.7",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist target",
    "dev": "node scripts/dev.mjs",
    "dev:debug": "RUST_LOG=xaga=debug npm run dev",
    "build": "npm run audit:report && npm run tauri build",
    "build:alpha": "node scripts/build-alpha.mjs",
    "test": "npm run test:scripts && npm run test:ui",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:ui": "vitest run",
    "icons:macos": "node scripts/generate-macos-icon.mjs",
    "lint": "eslint .",
    "audit": "cargo audit",
    "audit:report": "npm run audit || true",
    "icons": "node scripts/generate-icons.mjs",
    "tauri": "tauri",
    "check:uncommitted": "git diff --quiet && git diff --cached --quiet || (echo 'Working tree has uncommitted changes — commit or stash before releasing.' && exit 1)",
    "version:bump": "node scripts/bump-version.mjs",
    "version:patch": "npm run check:uncommitted && npm run version:bump -- patch",
    "version:minor": "npm run check:uncommitted && npm run version:bump -- minor",
    "version:major": "npm run check:uncommitted && npm run version:bump -- major",
    "version:rc": "npm run check:uncommitted && npm run version:bump -- rc",
    "version:release": "npm run check:uncommitted && npm run version:bump -- release",
    "release:tag": "node scripts/release-tag.mjs",
    "cli:debug": "cargo run -p xaga-cli --",
    "cli:build": "npm run audit:report && cargo build -p xaga-cli",
    "ui:dev": "vite",
    "ui:build": "node scripts/csp-hash.mjs --check && tsc -b && vite build",
    "ui:preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mozilla/readability": "^0.6.0",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@reedable/lliwio-css": "https://github.com/reedable/lliwio-css/releases/download/v0.0.3/reedable-lliwio-css-0.0.3.tgz",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "css-tree": "^3.2.1",
    "dompurify": "^3.4.7",
    "framer-motion": "^12.38.0",
    "parse5": "^7.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.14.1",
    "react-virtuoso": "^4.18.3",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "tldts": "^7.4.2",
    "unified": "^11.0.5",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^27.0.1",
    "knip": "^6.17.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.7"
  }
}
