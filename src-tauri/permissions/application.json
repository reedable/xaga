{
  "permission": [
    {
      "identifier": "allow-loader-callbacks",
      "description": "Only the capture and diagnostic callbacks used by article loader webviews.",
      "commands": {
        "allow": [
          "add_loader_diagnostic_event",
          "receive_html",
          "receive_favicon",
          "loader_will_unload",
          "loader_page_loaded",
          "capture_and_close_loader"
        ]
      }
    },
    {
      "identifier": "allow-trusted-ui-commands",
      "description": "First-party application commands; the Rust invoke gate also enforces window and write access.",
      "commands": {
        "allow": [
          "load_article",
          "create_article_diagnostic",
          "add_article_diagnostic_event",
          "get_article_diagnostic",
          "clear_webview_history",
          "save_article",
          "find_article",
          "read_article",
          "read_entry_images",
          "create_article",
          "add_annotation",
          "replace_annotation",
          "remove_annotation",
          "list_annotations",
          "is_cache_ready",
          "read_entry",
          "mark_entry_read",
          "mark_entry_unread",
          "list_all_items",
          "get_library",
          "set_library",
          "is_library_read_only",
          "get_theme",
          "set_theme",
          "get_refresh_on_startup",
          "set_refresh_on_startup",
          "get_html_reader_prefs",
          "set_html_reader_font_family",
          "set_html_reader_font_size",
          "set_html_reader_line_height",
          "get_show_sidebar",
          "set_show_sidebar",
          "get_allowed_domains",
          "set_allowed_domains",
          "get_html_reader_view",
          "set_html_reader_view",
          "set_feed_pinned",
          "set_topic_pinned",
          "get_inline_pdf_reader",
          "set_inline_pdf_reader",
          "list_feeds",
          "add_feed",
          "refresh_all_feeds",
          "rename_feed",
          "remove_feed",
          "list_entries",
          "add_bookmark",
          "remove_bookmark",
          "create_topic",
          "save_topic",
          "list_topics",
          "read_topic",
          "delete_topic",
          "add_topic_item",
          "remove_topic_item",
          "list_topic_items",
          "list_entry_topics",
          "rank_topics_by_item",
          "search_by_item",
          "search_by_text",
          "reset_embeddings"
        ]
      }
    }
  ]
}
