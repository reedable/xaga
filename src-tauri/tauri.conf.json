{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xaga",
  "version": "0.13.0-rc.1",
  "identifier": "app.xaga",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run icons && npm run ui:dev",
    "beforeBuildCommand": "npm run icons && npm run ui:build",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Xaga",
        "create": false,
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-ZmLnZpp1swBmCl6WL4X555JdDZwKvRp1uQHG2/s851M='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' blob: https:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["Assets.car"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/macos/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 700,
          "height": 500
        },
        "appPosition": {
          "x": 175,
          "y": 195
        },
        "applicationFolderPosition": {
          "x": 525,
          "y": 195
        }
      }
    }
  }
}
